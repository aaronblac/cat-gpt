# ---------------------------------------------------------------------------
# CatGPT configuration. Copy this file to `.env.local` and fill in ONE provider.
# Nothing in here is ever sent to the browser. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# Which brain answers the guests: auto | openai | anthropic | google | groq | openrouter | ollama | offline
# "auto" picks the first provider that has credentials, then falls back to the
# built-in offline comedy engine. "offline" never calls the network.
CATGPT_PROVIDER=auto

# --- OpenAI (platform.openai.com) ------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic Claude (console.anthropic.com) ------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Google Gemini (aistudio.google.com) ----------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash-lite

# --- Groq (console.groq.com) ----------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenRouter (openrouter.ai) -------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.5-flash-lite

# --- Ollama, running on a laptop in your bag (ollama.com) ------------------
# Example: http://localhost:11434 or http://192.168.1.20:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2

# --- Party guards ----------------------------------------------------------
# Per-guest-IP request budget (short window) and a global spend guard.
CATGPT_RATE_LIMIT=12
CATGPT_RATE_WINDOW_SECONDS=60
CATGPT_GLOBAL_LIMIT=120
CATGPT_MAX_ANSWER_CHARS=220

# Seconds before the screen clears itself for the next victim.
NEXT_PUBLIC_RESET_SECONDS=30
